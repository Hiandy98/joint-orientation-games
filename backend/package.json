{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node --watch --env-file=.env dist/index.js\"",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate":  "drizzle-kit migrate",
    "db:studio":   "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/pino": "^7.0.4",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
